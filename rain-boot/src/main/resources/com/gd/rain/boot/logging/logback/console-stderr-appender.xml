<?xml version="1.0" encoding="UTF-8"?>

<!--
Spring Boot's console appender (org/springframework/boot/logging/logback/console-appender.xml), writing to standard
error instead of standard output. A process started as a command writes its result on standard output; an application
whose logback-spring.xml includes this in place of Boot's console appender keeps every log line off it:

<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="com/gd/rain/boot/logging/logback/console-stderr-appender.xml"/>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>

The properties it reads are the ones Boot's defaults.xml defines.
-->

<included>
	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<target>System.err</target>
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>${CONSOLE_LOG_THRESHOLD}</level>
		</filter>
		<encoder>
			<pattern>${CONSOLE_LOG_PATTERN}</pattern>
			<charset>${CONSOLE_LOG_CHARSET}</charset>
		</encoder>
	</appender>
</included>
